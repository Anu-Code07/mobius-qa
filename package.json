{
  "name": "mobius-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI mobile QA engineer: runs plain-English test scenarios on real devices through the Mobius MCP server.",
  "engines": { "node": ">=22.18" },
  "bin": { "mobius-qa": "./src/cli.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "qa": "node src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319"
  },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "~5.9.3" }
}
